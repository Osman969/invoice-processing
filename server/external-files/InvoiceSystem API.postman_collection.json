			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "http://localhost:8080/invoice/{{invoiceId}}/item/{{itemSkuCode}}",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"invoice",
						"{{invoiceId}}",
						"item",
						"{{itemSkuCode}}"
					]
				}
			},
			"response": []
		},
		{
