						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"customerEmail\": \"customer@example.com\",\n  \"items\": [\n    {\n      \"sku\": \"SKU002\",\n      \"quantity\": 2\n    }\n  ]\n}"
